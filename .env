# CẤU HÌNH BIẾN MÔI TRƯỜNG CHO HỆ THỐNG NAC TẬP TRUNG
# Domain: dc=attt,dc=ptit,dc=edu,dc=vn

# LDAP
LDAP_ORGANISATION=PTITHCM An Toan Mang
LDAP_DOMAIN=attt.ptit.edu.vn
LDAP_BASE_DN=dc=attt,dc=ptit,dc=edu,dc=vn
LDAP_ADMIN_PASSWORD=AdminPassword123!
LDAP_CONFIG_PASSWORD=ConfigPassword123!

# FreeRADIUS & MariaDB
MYSQL_ROOT_PASSWORD=RootPassword123!
MYSQL_DATABASE=radius
MYSQL_USER=radius
MYSQL_PASSWORD=RadPassword123!

# RADIUS Shared Secret
RADIUS_SECRET=testing123

# Dashboard Web Key
SECRET_KEY=ptit-network-security-nac-secret-key-2026

# Active Defense Detector
BRUTEFORCE_THRESHOLD=6
BRUTEFORCE_WINDOW_SECONDS=180

# ====================================================================
# CẤU HÌNH GỬI EMAIL THẬT QUA GMAIL SMTP (CHO MÔI TRƯỜNG THỰC TẾ)
# ====================================================================
# Hướng dẫn bật gửi email thật về hòm thư Gmail của bạn:
# 1. Đổi SMTP_ENABLED=true
# 2. Điền địa chỉ Gmail vào SMTP_USER (Ví dụ: your_email@gmail.com)
# 3. Tạo Mật khẩu ứng dụng 16 ký tự tại: https://myaccount.google.com/apppasswords
# 4. Dán mật khẩu 16 chữ cái vào SMTP_PASSWORD (không có dấu cách)
# ====================================================================
SMTP_ENABLED=false
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USE_SSL=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=PTIT NAC & Central IAM Security
